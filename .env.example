# Copy to .env (git-ignored) and fill in. On Render, set these as environment variables instead.
# Supabase Dashboard -> Connect -> Session pooler (JDBC URL without credentials):
SUPABASE_DB_URL=jdbc:postgresql://<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=
# Supabase Dashboard -> Project Settings -> API Keys:
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
